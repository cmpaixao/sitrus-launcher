{
  "name": "sitrus-launcher",
  "version": "1.1.0",
  "description": "Launcher do pack Sitrus Cobblemon (Fabric 1.21.1)",
  "main": "electron/main.js",
  "author": "Sitrus",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win nsis portable --x64",
    "icon": "node scripts/make-icon.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "minecraft-launcher-core": "^3.18.2",
    "msmc": "^5.0.5"
  },
  "devDependencies": {
    "electron": "^33.4.5",
    "electron-builder": "^25.1.8",
    "png-to-ico": "^2.1.8"
  },
  "build": {
    "appId": "com.sitrus.launcher",
    "productName": "Sitrus Launcher",
    "asar": true,
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "sitrus.config.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "executableName": "Sitrus Launcher",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Sitrus Launcher",
      "uninstallDisplayName": "Sitrus Launcher",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "artifactName": "Sitrus-Launcher-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Sitrus-Launcher-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "cmpaixao",
      "repo": "sitrus-launcher",
      "releaseType": "release"
    }
  }
}
